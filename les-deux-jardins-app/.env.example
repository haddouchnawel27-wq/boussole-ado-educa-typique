# Les Deux Jardins — variables d'environnement
# Copie ce fichier en « .env.local » puis colle tes 2 clés Supabase (voir SETUP-SUPABASE.md).
# Tant que ces 2 lignes sont vides, l'app tourne en mode démo (aucune casse).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# VERROU DE SÉCURITÉ : laisser désactivé tant que l'hébergement et le cadre
# des données cliniques ne sont pas validés. La valeur "enabled" réactive
# explicitement les lectures/écritures cliniques Supabase.
NEXT_PUBLIC_LDJ_CLINICAL_STORAGE=disabled
