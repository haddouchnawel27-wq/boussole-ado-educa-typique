# Les Deux Jardins — variables d'environnement
# Copie ce fichier en « .env.local » puis colle tes 2 clés Supabase (voir SETUP-SUPABASE.md).
# Tant que ces 2 lignes sont vides, l'app tourne en mode démo (aucune casse).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# VERROU DE SÉCURITÉ : laisser désactivé pour l'usage individuel de Nawel.
# Les dossiers sont alors sauvegardés automatiquement dans son navigateur ;
# aucune donnée clinique n'est lue ou écrite dans Supabase.
# La valeur "enabled" réactive explicitement le stockage clinique Supabase et
# ne doit être utilisée qu'après validation du futur cadre HDS/RGPD.
NEXT_PUBLIC_LDJ_CLINICAL_STORAGE=disabled
